# Copy to .env and fill in the blanks. Never commit .env.

# --- Language model (Azure OpenAI chat deployment) ---
MODEL_PROVIDER=AZURE
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini

# --- Embeddings (Azure OpenAI embedding deployment) ---
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- LangSmith tracing and evaluation ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="supplyguard-ai"

# --- PostgreSQL + pgvector (docker compose) ---
POSTGRES_USER=supplyguard
POSTGRES_PASSWORD=
POSTGRES_DB=supplyguard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Neo4j (password must be at least 8 characters) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- ChromaDB ---
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- External services and MCP servers ---
RISK_FEED_URL=http://localhost:8099
PROCUREMENT_MCP_URL=http://localhost:8100/mcp
EXTERNAL_MCP_URL=http://localhost:8200/mcp

# --- Chainlit (generate with: uv run chainlit create-secret) ---
CHAINLIT_AUTH_SECRET=

# --- Demo sign-in password for all users in support-data/config/users.csv (local demo only) ---
DEMO_PASSWORD=supplyguard

# --- Demo login passwords for the users in support-data/config/users.csv (stored hashed by seed_users) ---
USER_PASSWORD_U_PM_01=
USER_PASSWORD_U_AN_01=
USER_PASSWORD_U_IC_01=
USER_PASSWORD_U_FC_01=
USER_PASSWORD_U_RO_01=
